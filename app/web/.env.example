# 백엔드(app/core) 주소. Tauri sidecar / 웹 서버 어디를 쓰든 여기로만 바꾼다.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8100

# 1 이면 목 모드. 백엔드 없이 UI 전체 흐름을 확인할 수 있다.
NEXT_PUBLIC_MOCK=0

# 목 모드 시나리오: desktop(기본) | desktop-nokey | web
# desktop        : 구독 사용 가능 -> 바로 워크스페이스
# desktop-nokey  : Claude Code 미설치 -> 온보딩(설치 안내 + 키 입력)
# web            : 웹 배포(구독 불가) -> 온보딩(키 입력만)
NEXT_PUBLIC_MOCK_MODE=desktop
